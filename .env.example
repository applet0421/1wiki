# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onewiki
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/onewiki

# Authentication
AUTH_SESSION_SECRET=
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_DISPLAY_NAME=

# AI provider: deepseek | openai | gemini
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# AI article images (Nano Banana 2 native parameters; no resizing)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# 512 | 1K | 2K | 4K (uppercase K)
GEMINI_IMAGE_SIZE=512
# 1:1 | 1:4 | 1:8 | 2:3 | 3:2 | 3:4 | 4:1 | 4:3 | 4:5 | 5:4 | 8:1 | 9:16 | 16:9 | 21:9
GEMINI_IMAGE_ASPECT_RATIO=9:16
GEMINI_IMAGE_ALT_MODEL=gemini-3.1-flash-lite
WORKER_START_COMMAND=
WORKER_RESTART_COMMAND=
WORKER_STOP_COMMAND=

# Cloudflare R2 article images
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# AdSense (disabled by default)
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_DESKTOP_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_DESKTOP=
NEXT_PUBLIC_ADSENSE_SLOT_FEED_INLINE=
ADSENSE_PUBLISHER_ID=
