# Copy to .env.production at the project root and fill every value.
# Native Compose uses SITE_HOST as the canonical host and redirects
# SITE_REDIRECT_HOST to it. Coolify Proxy uses the domains configured in Coolify;
# these Caddy variables may remain unused in that mode.
SITE_HOST=www.example.com
SITE_REDIRECT_HOST=example.com
POSTGRES_DB=onewiki
POSTGRES_USER=onewiki
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The application values below are loaded by web and worker.
NEXT_PUBLIC_SITE_URL=https://www.example.com
CACHE_REVALIDATE_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://onewiki:replace-me@postgres:5432/onewiki
DIRECT_URL=postgresql://onewiki:replace-me@postgres:5432/onewiki
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
GSC_SITE_URL=
GSC_SITEMAP_URL=
GSC_CLIENT_ID=
GSC_CLIENT_SECRET=
GSC_REFRESH_TOKEN=
DATABASE_BACKUP_R2_BUCKET=
DATABASE_BACKUP_R2_PREFIX=database-backups

# Optional Cloudflare HTML cache purge. Leave blank to use origin ISR only.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# AdSense: enable only after the site, consent handling, and policy pages are reviewed.
NEXT_PUBLIC_ADSENSE_ENABLED=false
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_MID=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE_END=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_DESKTOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_DESKTOP_STICKY=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_AFTER_INTRO=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_INLINE=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_END=
NEXT_PUBLIC_ADSENSE_SLOT_CATEGORY_SIDEBAR_DESKTOP=
NEXT_PUBLIC_ADSENSE_SLOT_FEED_INLINE=
NEXT_PUBLIC_CATEGORY_INLINE_AD_INTERVAL=10
ADSENSE_PUBLISHER_ID=
