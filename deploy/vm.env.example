# Copy to .env.production at the project root and fill every value.
SITE_HOST=www.example.com
POSTGRES_DB=onewiki
POSTGRES_USER=onewiki
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The application values below are loaded by web and worker.
NEXT_PUBLIC_SITE_URL=https://www.example.com
DATABASE_URL=postgresql://onewiki:replace-me@postgres:5432/onewiki
DIRECT_URL=postgresql://onewiki:replace-me@postgres:5432/onewiki
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Cloudflare R2
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Keep monetization disabled until independently reviewed.
NEXT_PUBLIC_ADSENSE_ENABLED=false
