generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum AIContentType {
  TROUBLESHOOTING
  HOW_TO
}

enum AISourceSupport {
  STRONG
  MEDIUM
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  displayName         String
  passwordHash        String    @db.Text
  role                UserRole  @default(EDITOR)
  isActive            Boolean   @default(true)
  mustChangePassword  Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  sessions            Session[]
  posts               Post[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]
}

model Post {
  id             String     @id @default(cuid())
  title          String
  slug           String     @unique
  excerpt        String     @default("") @db.Text
  contentHtml    String     @default("") @db.Text
  coverImage     String?    @db.Text
  status         PostStatus @default(DRAFT)
  authorId       String
  categoryId     String
  seoTitle       String?    @db.Text
  seoDescription String?    @db.Text
  seoKeywords    String?    @db.Text
  canonicalUrl   String?    @db.Text
  aiContentType  AIContentType?
  primaryKeyword String?    @db.Text
  searchIntent   String?    @db.Text
  aiSourceSupport AISourceSupport?
  aiNeedsVerification Json?
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  author         User       @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category       Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([authorId])
}
