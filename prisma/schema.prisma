generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  EDITOR
}

enum PostStatus {
  DRAFT
  PUBLISHED
}

enum PageStatus {
  DRAFT
  PUBLISHED
}

enum AIContentType {
  TROUBLESHOOTING
  HOW_TO
}

enum AISourceSupport {
  STRONG
  MEDIUM
}

enum LLMUsageStatus {
  SUCCESS
  FAILURE
}

enum TrafficSyncStatus {
  RUNNING
  SUCCESS
  FAILURE
}

enum SearchNotificationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PublicInvalidationStatus {
  PENDING
  SUCCESS
  FAILED
}

enum DatabaseBackupStatus {
  RUNNING
  SUCCESS
  FAILURE
}

enum DatabaseBackupTrigger {
  SCHEDULE
  MANUAL
}

model User {
  id                    String            @id @default(cuid())
  username              String            @unique
  displayName           String
  passwordHash          String            @db.Text
  role                  UserRole          @default(EDITOR)
  isActive              Boolean           @default(true)
  mustChangePassword    Boolean           @default(true)
  failedLoginAttempts   Int               @default(0)
  lockedUntil           DateTime?
  passwordChangedAt     DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  sessions              Session[]
  posts                 Post[]
  promptVersionsCreated PromptVersion[]
  modelPricesCreated    LLMModelPrice[]
  imageGenerations      ImageGeneration[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
}

model Category {
  id               String     @id @default(cuid())
  locale           String
  name             String
  slug             String
  description      String     @default("") @db.Text
  parentId         String?
  showInNavigation Boolean    @default(false)
  sortOrder        Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  parent           Category?  @relation("CategoryTree", fields: [parentId, locale], references: [id, locale], onDelete: Restrict)
  children         Category[] @relation("CategoryTree")
  posts            Post[]
  sitePages        SitePage[]
  trafficTotals     TrafficPageTotal[]

  @@unique([id, locale])
  @@unique([locale, slug])
  @@index([locale, parentId, sortOrder])
}

model Author {
  id          String   @id @default(cuid())
  locale      String
  name        String
  slug        String
  contentHtml String   @default("") @db.Text
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       Post[]

  @@unique([id, locale])
  @@unique([locale, slug])
  @@index([locale, archivedAt, name])
}

model Post {
  id                  String           @id @default(cuid())
  locale              String
  title               String
  slug                String
  excerpt             String           @default("") @db.Text
  contentHtml         String           @default("") @db.Text
  coverImage          String?          @db.Text
  status              PostStatus       @default(DRAFT)
  authorId            String
  categoryId          String
  bylineId            String?
  seoTitle            String?          @db.Text
  seoDescription      String?          @db.Text
  seoKeywords         String?          @db.Text
  canonicalUrl        String?          @db.Text
  aiContentType       AIContentType?
  primaryKeyword      String?          @db.Text
  searchIntent        String?          @db.Text
  aiSourceSupport     AISourceSupport?
  aiNeedsVerification Json?
  publishedAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  author              User             @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category            Category         @relation(fields: [categoryId, locale], references: [id, locale], onDelete: Restrict)

  byline Author? @relation(fields: [bylineId, locale], references: [id, locale], onDelete: Restrict)

  imageGenerations ImageGeneration[]
  trafficTotals     TrafficPageTotal[]

  @@unique([locale, slug])
  @@index([status, publishedAt])
  @@index([locale, status, publishedAt])
  @@index([categoryId, status])
  @@index([authorId])
  @@index([bylineId, locale])
}

model SitePage {
  id              String     @id @default(cuid())
  locale          String
  title           String
  slug            String
  excerpt         String     @default("") @db.Text
  contentHtml     String     @default("") @db.Text
  status          PageStatus @default(DRAFT)
  seoTitle        String?    @db.Text
  seoDescription  String?    @db.Text
  seoKeywords     String?    @db.Text
  canonicalUrl    String?    @db.Text
  categoryId      String?
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  category        Category?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([locale, slug])
  @@index([locale, status, publishedAt])
  @@index([categoryId, locale, status])
}

model TrafficPageTotal {
  id                String   @id @default(cuid())
  pagePath          String
  pageTitle         String   @default("")
  pageType          String
  locale            String?
  postId            String?
  categoryId        String?
  views             Int      @default(0)
  syncedAt          DateTime @default(now())
  post              Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@unique([pagePath])
  @@index([locale])
  @@index([categoryId])
  @@index([postId])
}

model TrafficSyncRun {
  id          String            @id @default(cuid())
  status      TrafficSyncStatus @default(RUNNING)
  fromDate    DateTime          @db.Date
  toDate      DateTime          @db.Date
  rowCount    Int               @default(0)
  error       String?           @db.VarChar(500)
  startedAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([startedAt])
  @@index([status, startedAt])
}

model PromptDefinition {
  id                  String          @id @default(cuid())
  key                 String          @unique
  name                String
  description         String          @db.Text
  allowedVariables    Json
  requiredVariables   Json
  activeVersionNumber Int
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  versions            PromptVersion[]
  usage               LLMUsage[]
}

model PromptVersion {
  id                 String           @id @default(cuid())
  promptDefinitionId String
  versionNumber      Int
  systemTemplate     String           @db.Text
  userTemplate       String           @db.Text
  createdById        String?
  createdAt          DateTime         @default(now())
  promptDefinition   PromptDefinition @relation(fields: [promptDefinitionId], references: [id], onDelete: Restrict)
  createdBy          User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  usage              LLMUsage[]

  @@unique([promptDefinitionId, versionNumber])
  @@index([createdById])
}

model LLMModelPrice {
  id                             String   @id @default(cuid())
  provider                       String
  model                          String
  inputUsdPerMillionTokens       Decimal  @db.Decimal(18, 8)
  outputUsdPerMillionTokens      Decimal  @db.Decimal(18, 8)
  imageOutputUsdPerMillionTokens Decimal? @db.Decimal(18, 8)
  effectiveAt                    DateTime
  createdById                    String?
  createdAt                      DateTime @default(now())
  createdBy                      User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([provider, model, effectiveAt])
  @@index([provider, model, effectiveAt])
}

model LLMUsage {
  id                                     String           @id @default(cuid())
  promptDefinitionId                     String
  promptVersionId                        String
  provider                               String
  model                                  String
  status                                 LLMUsageStatus
  inputTokens                            Int?
  outputTokens                           Int?
  imageOutputTokens                      Int?
  totalTokens                            Int?
  durationMs                             Int
  errorSummary                           String?          @db.VarChar(500)
  inputUsdPerMillionTokensSnapshot       Decimal?         @db.Decimal(18, 8)
  outputUsdPerMillionTokensSnapshot      Decimal?         @db.Decimal(18, 8)
  imageOutputUsdPerMillionTokensSnapshot Decimal?         @db.Decimal(18, 8)
  estimatedCostUsd                       Decimal?         @db.Decimal(18, 10)
  createdAt                              DateTime         @default(now())
  promptDefinition                       PromptDefinition @relation(fields: [promptDefinitionId], references: [id], onDelete: Restrict)
  promptVersion                          PromptVersion    @relation(fields: [promptVersionId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([promptDefinitionId, createdAt])
  @@index([provider, model, createdAt])
  @@index([status, createdAt])
}

model ImageGeneration {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId         String?
  post           Post?     @relation(fields: [postId], references: [id], onDelete: SetNull)
  locale         String
  title          String
  paragraphs     Json
  targetId       String
  prompt         String    @db.Text
  alt            String    @db.Text
  reason         String    @db.Text
  model          String
  imageSize      String
  aspectRatio    String
  altModel       String
  status         String    @default("PLANNED")
  imageBytes     Bytes?
  mimeType       String?
  publicUrl      String?
  objectKey      String?
  width          Int?
  height         Int?
  error          String?   @db.VarChar(500)
  altWarning     String?   @db.VarChar(500)
  leaseExpiresAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([postId])
}

model WorkerHeartbeat {
  id            String   @id
  name          String
  desiredState  String   @default("RUNNING")
  startedAt     DateTime
  lastHeartbeat DateTime
  processed     Int      @default(0)
  lastError     String?  @db.VarChar(500)
  updatedAt     DateTime @updatedAt
}

model DatabaseBackupSetting {
  id             String   @id
  enabled        Boolean  @default(true)
  dailyTime      String   @default("02:00")
  timezone       String   @default("Asia/Taipei")
  retentionCount Int      @default(7)
  updatedAt      DateTime @updatedAt
}

model DataRetentionSetting {
  id                         String   @id
  llmUsageDays               Int      @default(180)
  trafficSyncRunDays         Int      @default(180)
  searchSuccessDays          Int      @default(90)
  searchFailureDays          Int      @default(365)
  imageGenerationDays        Int      @default(90)
  publicInvalidationDays     Int      @default(180)
  databaseBackupFailureDays  Int      @default(30)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model DatabaseBackup {
  id          String                @id @default(cuid())
  status      DatabaseBackupStatus  @default(RUNNING)
  trigger     DatabaseBackupTrigger
  scheduleKey String?               @unique
  objectKey   String?               @db.Text
  fileName    String?               @db.VarChar(255)
  fileSize    BigInt?
  checksum    String?               @db.VarChar(64)
  error       String?               @db.VarChar(1000)
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([status, startedAt])
  @@index([createdAt])
}

model SearchEngineNotification {
  id          String                   @id @default(cuid())
  engine      String
  url         String                   @db.Text
  eventType   String
  status      SearchNotificationStatus @default(PENDING)
  attempts    Int                      @default(0)
  lastError   String?                  @db.VarChar(500)
  nextAttemptAt DateTime               @default(now())
  createdAt   DateTime                 @default(now())
  sentAt      DateTime?

  @@unique([engine, url, eventType])
  @@index([status, nextAttemptAt])
}

model PublicInvalidation {
  id            String                   @id @default(cuid())
  paths         Json
  status        PublicInvalidationStatus @default(PENDING)
  attempts      Int                      @default(0)
  lastError     String?                  @db.VarChar(500)
  nextAttemptAt DateTime                 @default(now())
  createdAt     DateTime                 @default(now())
  completedAt   DateTime?

  @@index([status, nextAttemptAt])
}
